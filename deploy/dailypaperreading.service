[Unit]
Description=Daily paper reading
After=network.target

[Service]
WorkingDirectory=%h/workspace/dailypaperreading
Environment=PATH=%h/.local/node/bin:/usr/bin
Environment=HOME=%h
Environment=HOST=127.0.0.1
Environment=PORT=43129
EnvironmentFile=-%h/workspace/dailypaperreading/service.env
ExecStart=%h/.local/node/bin/node %h/workspace/dailypaperreading/server/index.js
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
